{
  "extends": ["stylelint-config-standard"],
  "overrides": [
    {
      "files": ["**/*.css"],
      "customSyntax": "postcss-syntax"
    }
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "theme",
          "utility",
          "apply",
          "layer",
          "import"
        ]
      }
    ],
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": [
          "text-size-adjust",
          "user-drag",
          "scrollbar-width"
        ]
      }
    ],
    "function-no-unknown": [
      true,
      {
        "ignoreFunctions": ["env"]
      }
    ]
  }
}
