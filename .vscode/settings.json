{
  "deno.enable": true,
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },

  // --- CONFIGURATION TAILWIND V4 & CSS ---

  // 1. Associer les fichiers CSS au mode Tailwind
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // 2. Suggestions intelligentes
  "editor.quickSuggestions": {
    "strings": true
  },

  // 3. LA SOLUTION : On ignore spécifiquement les règles inconnues (@theme, @tailwind)
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",

  // 4. (Optionnel) Désactiver complètement la validation native si le point 3 ne suffit pas
  "css.validate": false,
  "scss.validate": false
}